{
    "name": "projet1",
    "version": "1.0.0",
    "description": "Application de gestion de cargaison",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "dev": "webpack serve --mode development",
        "build:prod": "webpack --mode production",
        "start": "npm run build && node dist/main.js",
        "json-server": "cd json-server && npm run dev",
        "start:all": "concurrently \"npm run json-server\" \"npm run dev\"",
        "install:all": "npm install && cd json-server && npm install"
    },
    "keywords": [
        "cargaison",
        "typescript",
        "tailwind"
    ],
