    "license": "ISC",
    "devDependencies": {
        "@types/leaflet": "^1.9.20",
        "autoprefixer": "^10.4.17",
        "concurrently": "^9.2.0",
        "css-loader": "^6.10.0",
        "html-webpack-plugin": "^5.6.0",
        "postcss": "^8.4.33",
        "postcss-loader": "^8.1.0",
        "style-loader": "^3.3.4",
        "tailwindcss": "^3.4.1",
        "ts-loader": "^9.5.1",
        "typescript": "^5.9.2",
        "webpack": "^5.90.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.1"
    }
